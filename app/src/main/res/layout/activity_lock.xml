<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="28dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <!-- status line: the only place time-of-day appears -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dndLine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-monospace"
            android:letterSpacing="0.04"
            android:textColor="@color/faint"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/metaLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-monospace"
            android:letterSpacing="0.08"
            android:textColor="@color/dim"
            android:textSize="9sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/stroke" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- the instrument: one dot-matrix clock, edge to edge -->
    <LinearLayout
        android:id="@+id/lockContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.lockin.ui.DotMatrixView
            android:id="@+id/timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.lockin.ui.DotGridProgressView
            android:id="@+id/goalGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/goalLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-monospace"
            android:gravity="start"
            android:letterSpacing="0.08"
            android:textColor="@color/faint"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/lockBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke" />

        <LinearLayout
            android:id="@+id/nowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/npTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/npArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/faint"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/npNext"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="Next song"
                android:padding="10dp"
                android:src="@drawable/ic_next" />
        </LinearLayout>

        <TextView
            android:id="@+id/doomBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_btn_red_outline"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.14"
            android:text="@string/doomscroll"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/doomHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:textColor="@color/faint"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/appsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/panelBtn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_btn_outline"
            android:fontFamily="sans-serif-monospace"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="QUICK PANEL  ·  1 MIN"
            android:textColor="@color/dim"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.lockin.ui.HoldButton
                android:id="@+id/pauseBtn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.lockin.ui.HoldButton
                android:id="@+id/endBtn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
