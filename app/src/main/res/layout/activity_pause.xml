<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="28dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_bar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.3"
            android:text="@string/paused"
            android:textColor="@color/accent"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/stroke" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.lockin.ui.DotMatrixView
        android:id="@+id/pauseTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/pauseSince"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/dim"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/pauseMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-monospace"
        android:letterSpacing="0.08"
        android:textColor="@color/faint"
        android:textSize="9sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/resumeBtn"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@drawable/bg_btn_red"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.18"
        android:text="@string/resume"
        android:textColor="@color/on_accent"
        android:textSize="14sp" />

    <com.lockin.ui.HoldButton
        android:id="@+id/endBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp" />
</LinearLayout>
