<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widgetLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.32"
        android:text="TODAY"
        android:textColor="@color/faint"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widgetTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-light"
        android:text="0m"
        android:textColor="@color/text"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/widgetMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:letterSpacing="0.08"
        android:text="NO SESSIONS YET"
        android:textColor="@color/dim"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widgetStart"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_btn_red"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.14"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="LOCK IN"
        android:textColor="@color/on_accent"
        android:textSize="9sp" />
</LinearLayout>
