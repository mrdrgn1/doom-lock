<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="26dp"
        android:paddingEnd="24dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/weekBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:text="@string/back"
                android:textColor="@color/dim"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-monospace"
                android:letterSpacing="0.24"
                android:text="THIS WEEK"
                android:textColor="@color/faint"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/weekRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.16"
            android:textColor="@color/dim"
            android:textSize="10sp" />

        <com.lockin.ui.DotMatrixView
            android:id="@+id/weekTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/weekSessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.1"
            android:textColor="@color/dim"
            android:textSize="10sp" />

        <com.lockin.ui.WeekBarsView
            android:id="@+id/weekBarsFull"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp" />

        <LinearLayout
            android:id="@+id/weekDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="@color/stroke" />

        <TextView
            android:id="@+id/weekGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.1"
            android:textColor="@color/dim"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/weekDoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.1"
            android:textColor="@color/dim"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/weekHour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.1"
            android:textColor="@color/accent"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/weekFreezes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.1"
            android:textColor="@color/faint"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
