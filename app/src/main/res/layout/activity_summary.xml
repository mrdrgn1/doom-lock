<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="30dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.32"
        android:text="SESSION DONE"
        android:textColor="@color/faint"
        android:textSize="9sp" />

    <com.lockin.ui.DotMatrixView
        android:id="@+id/summaryTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp" />

    <TextView
        android:id="@+id/lockedShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.12"
        android:textColor="@color/dim"
        android:textSize="10sp" />

    <com.lockin.ui.SessionTimelineView
        android:id="@+id/summaryTimeline"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="26dp" />

    <TextView
        android:id="@+id/spanValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:letterSpacing="0.08"
        android:textColor="@color/faint"
        android:textSize="10sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="26dp"
        android:background="@color/stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.24"
                android:text="LOCKED IN"
                android:textColor="@color/accent"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/lockedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.24"
                android:text="UNLOCKED"
                android:textColor="@color/faint"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/unlockedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/summaryDone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_btn_red"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.18"
        android:text="DONE"
        android:textColor="@color/on_accent"
        android:textSize="15sp" />
</LinearLayout>
